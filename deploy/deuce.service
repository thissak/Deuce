[Unit]
Description=Deuce web and realtime API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=deuce
Group=deuce
WorkingDirectory=/opt/deuce/current/apps/server
EnvironmentFile=/etc/deuce/deuce.env
Environment=PATH=/opt/deuce/node/bin:/usr/bin:/bin
ExecStart=/opt/deuce/node/bin/node --import tsx src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/deuce
MemoryHigh=768M
MemoryMax=1G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
