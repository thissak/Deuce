NODE_ENV=production
HOST=127.0.0.1
PORT=4010
WEB_DIST_DIR=/opt/deuce/current/apps/web/dist
UPLOAD_DIR=/var/lib/deuce/uploads
MAX_UPLOAD_BYTES=26214400
DATABASE_URL=postgresql://deuce:REPLACE@127.0.0.1:5432/deuce
SESSION_KEY_HEX=
GOOGLE_CLIENT_ID=REPLACE
GOOGLE_CLIENT_SECRET=REPLACE
GOOGLE_CALLBACK_URL=https://chat.example.com/auth/google/callback
ALLOWED_EMAILS=REPLACE

DESKTOP_DOWNLOAD_DIR=/var/lib/deuce/downloads

# Desktop app OAuth client ID (separate from web client)
GOOGLE_DESKTOP_CLIENT_ID=REPLACE
